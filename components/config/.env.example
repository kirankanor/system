# Copy to .env (never commit .env). Load with: load_settings(".env")
# Prefix RAG_, nesting with double underscore.

# --- required: no defaults on purpose (they define your index) ---
RAG_EMBEDDING__PROVIDER=your-embedding-provider
RAG_EMBEDDING__MODEL=your-embedding-model
RAG_EMBEDDING__DIMENSIONS=1024
RAG_VECTOR_STORE__PROVIDER=your-vector-store
RAG_LLM__PROVIDER=your-llm-provider
RAG_LLM__MODEL=your-llm-model

# --- secrets ---
# RAG_EMBEDDING__API_KEY=
# RAG_LLM__API_KEY=
# RAG_VECTOR_STORE__API_KEY=
# RAG_VECTOR_STORE__URL=

# --- optional tuning (defaults shown) ---
# RAG_CHUNKING__SIZE=1000
# RAG_CHUNKING__OVERLAP=150
# RAG_CHUNKING__UNIT=chars
# RAG_VECTOR_STORE__DISTANCE_METRIC=cosine
# RAG_RETRIEVAL__TOP_K=5
# RAG_RETRIEVAL__MAX_CONTEXT_CHARS=12000
# RAG_LLM__TEMPERATURE=0.0
# RAG_INGESTION__MAX_PAGES=2000
